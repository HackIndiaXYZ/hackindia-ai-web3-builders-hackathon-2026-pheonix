{
  "name": "land-registry-frontend",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node serve.js",
    "test": "node --test test/*.test.js",
    "build": "esbuild src/main.jsx --bundle --minify --outfile=dist/bundle.js --jsx=automatic --loader:.jsx=jsx --define:process.env.NODE_ENV='\"production\"' && tailwindcss -i ./src/index.css -o ./dist/bundle.css --config ./tailwind.config.cjs --minify",
    "watch": "esbuild src/main.jsx --bundle --outfile=dist/bundle.js --jsx=automatic --loader:.jsx=jsx --define:process.env.NODE_ENV='\"development\"' --watch"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-is": "^19.3.0",
    "react-map-gl": "^7.1.9",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.20.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17"
  }
}
