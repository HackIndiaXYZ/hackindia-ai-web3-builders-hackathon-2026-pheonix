# Development only — never commit real credentials.

# ----------------------------------------------------------------- chain ----
CHAIN_MODE=mock
# For deployment, configure the approved MST provider and protected registrar signer.
MST_NETWORK=testnet

# ----------------------------------------------------------- persistence ----
# Unset entirely to run the zero-infrastructure in-memory demo.
# Set it (Supabase supplies this, or use the local docker-compose stack) to
# switch the V2 registry onto PostgreSQL. Server-side only — never expose this
# to the frontend.
DATABASE_URL=postgresql://land_registry:local-dev-only@localhost:5432/land_registry

# Shared sessions, rate limits and lookup caches. Required whenever
# DATABASE_URL is set: process-local state is not correct across gunicorn
# workers or multiple replicas.
REDIS_URL=redis://localhost:6379/0

# Compose reads this to build both DATABASE_URL and the database's own
# password, so they cannot drift apart.
POSTGRES_PASSWORD=local-dev-only

# ---------------------------------------------------------------- session ----
# Replace with a strong random value (e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`). Boot fails if this is left at a known
# placeholder while DATABASE_URL is configured.
SESSION_SECRET=local-dev-only-change-me
SESSION_TTL_SECONDS=3600

# ------------------------------------------------------------ edge limits ----
RATE_LIMIT_PER_MINUTE=120
# Only needed when the frontend is served from a different origin.
ALLOWED_ORIGIN=

# ----------------------------------------------------------------- worker ----
# Seconds between outbox polls, and how many times a failing event is retried
# before it is parked as FAILED for human review.
OUTBOX_POLL_INTERVAL=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=10

# ---------------------------------------------------------- observability ----
LOG_LEVEL=INFO

# --------------------------------------------------- external integrations ----
OBJECT_STORAGE_ENDPOINT=https://storage.example.invalid
UIDAI_INTEGRATION_MODE=unconfigured
